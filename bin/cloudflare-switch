#!/usr/bin/env bash
# cloudflare-switch
# Toggle the Cloudflare DNS override (1.1.1.3 / 1.0.0.3 — Family/Malware
# blocking resolver) for systemd-networkd setups (e.g. Omarchy).
# "off" falls back to DHCP/router DNS; "on" brings Cloudflare back.
#
# Handles:
#   - per-link DNS= files under /etc/systemd/network/
#   - /etc/systemd/resolved.conf (DNS= / FallbackDNS=) and resolved.conf.d/
#   - Full resolved cache flush + restart ordering fix
#   - Persisting the chosen state across reboots: the first time you run
#     "on" or "off", this script installs its own tiny systemd service
#     (cloudflare-switch-restore.service) that re-applies your last choice
#     at every boot. No extra files to install — it's all in this one script.
#
# Install:
#   chmod +x cloudflare-switch
#   sudo mv cloudflare-switch /usr/local/bin/cloudflare-switch
#
# Usage:
#   cloudflare-switch status        -> show whether the override is ON/OFF
#   sudo cloudflare-switch off      -> disable Cloudflare DNS override
#   sudo cloudflare-switch on       -> re-enable Cloudflare DNS override
#   cloudflare-switch doctor        -> status + sanity checks
#
# Internal (auto-installed on first "on"/"off" run — not meant to be typed
# by hand):
#   sudo cloudflare-switch apply-state

set -euo pipefail

NETWORK_DIR="/etc/systemd/network"
RESOLVED_CONF="/etc/systemd/resolved.conf"
RESOLVED_CONF_D="/etc/systemd/resolved.conf.d"
BACKUP_DIR="/etc/systemd/network/.dns_switch_backups"
STATE_DIR="/etc/cloudflare-switch"
STATE_FILE="$STATE_DIR/state"
SYSTEMD_UNIT_PATH="/etc/systemd/system/cloudflare-switch-restore.service"
INSTALLED_BIN_PATH="/usr/local/bin/cloudflare-switch"
PROG_NAME="$(basename "$0")"

# Colors (auto-disabled when not attached to a terminal, e.g. piped/logged)
if [ -t 1 ]; then
    C_RED=$'\033[1;31m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""; C_RESET=""
fi

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: this action needs root. Run: sudo $PROG_NAME ${1:-}"
        exit 1
    fi
}

require_tools() {
    for tool in resolvectl networkctl ip find sed grep; do
        if ! command -v "$tool" &>/dev/null; then
            echo "Error: required tool '$tool' not found."
            exit 1
        fi
    done
}

get_primary_iface() {
    ip route show default 2>/dev/null | awk '/default/ {print $5; exit}'
}

# Persist the last state the user asked for ("on" or "off") so it can be
# re-applied automatically at boot if something (NetworkManager, a
# generator, a package update regenerating .network files, etc.) resets
# the on-disk config back to its default between shutdown and the next
# boot. This is what fixes the "off, reboot, and it's back on" issue.
save_state() {
    mkdir -p "$STATE_DIR"
    echo "$1" > "$STATE_FILE"
    ensure_boot_service
}

# Self-installs (once) the systemd unit that re-applies the saved state at
# every boot, so the whole fix ships as this single file — no second
# .service file to move into place by hand. Safe to call repeatedly: it
# only (re)writes when missing/outdated and is idempotent either way.
ensure_boot_service() {
    # If we're not actually installed at a stable path yet (e.g. running
    # straight from a Downloads folder), skip — nothing stable to point at.
    local self_path
    self_path="$(readlink -f "$0" 2>/dev/null || echo "$0")"

    local desired_unit
    desired_unit="$(cat <<EOF
[Unit]
Description=Re-apply saved cloudflare-switch DNS state (on/off) after boot
After=systemd-networkd.service systemd-resolved.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$self_path apply-state
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
EOF
)"

    if [ -f "$SYSTEMD_UNIT_PATH" ] && [ "$(cat "$SYSTEMD_UNIT_PATH")" = "$desired_unit" ]; then
        return 0
    fi

    echo "Installing boot-time restore service ($SYSTEMD_UNIT_PATH)..."
    printf '%s\n' "$desired_unit" > "$SYSTEMD_UNIT_PATH"
    systemctl daemon-reload
    systemctl enable cloudflare-switch-restore.service &>/dev/null || true
}

# Restart order matters: networkd first (re-applies link DNS),
# THEN resolved (rebuilds its view from networkd + resolved.conf),
# THEN flush caches so nothing stale lingers.
apply_changes() {
    echo "Applying changes..."
    systemctl restart systemd-networkd
    sleep 1

    local iface
    iface="$(get_primary_iface)"
    if [ -n "$iface" ]; then
        networkctl reconfigure "$iface" 2>/dev/null || true
        sleep 1
    fi

    systemctl restart systemd-resolved
    sleep 2

    resolvectl flush-caches 2>/dev/null || true
    # Older fallback name, harmless if missing
    systemd-resolve --flush-caches 2>/dev/null || true
}

show_status() {
    local link_lines resolved_lines override_active

    link_lines="$(grep -rn "^DNS=" "$NETWORK_DIR" --include="*" 2>/dev/null | grep -v "/.dns_switch_backups/" || true)"
    resolved_lines="$( {
        grep -n "^\(DNS\|FallbackDNS\)=" "$RESOLVED_CONF" 2>/dev/null
        [ -d "$RESOLVED_CONF_D" ] && grep -rn "^\(DNS\|FallbackDNS\)=" "$RESOLVED_CONF_D" 2>/dev/null
        true
    } )"

    if [ -n "$link_lines" ] || [ -n "$resolved_lines" ]; then
        override_active=1
    else
        override_active=0
    fi

    echo "===== Cloudflare DNS Override Status ====="
    if [ "$override_active" -eq 1 ]; then
        echo "Override: ${C_GREEN}${C_BOLD}ACTIVE${C_RESET} (Cloudflare DNS in use)"
    else
        echo "Override: ${C_RED}${C_BOLD}INACTIVE${C_RESET} (using router/DHCP DNS)"
    fi
    if [ -f "$STATE_FILE" ]; then
        echo "Saved preference (survives reboot): ${C_BOLD}$(cat "$STATE_FILE")${C_RESET}"
    fi
    echo

    echo "-- Effective resolver (resolvectl) --"
    local iface
    iface="$(get_primary_iface)"
    if [ -n "$iface" ]; then
        resolvectl status "$iface" 2>/dev/null | grep -E "Current DNS Server|DNS Servers" || true
    else
        resolvectl status | grep -E "Current DNS Server|DNS Servers" || true
    fi
    echo

    echo "-- Per-link DNS= lines in $NETWORK_DIR --"
    if [ -n "$link_lines" ]; then
        echo "${C_YELLOW}$link_lines${C_RESET}"
    else
        echo "  (none)"
    fi
    echo

    echo "-- Global DNS=/FallbackDNS= in $RESOLVED_CONF and $RESOLVED_CONF_D --"
    if [ -n "$resolved_lines" ]; then
        echo "${C_YELLOW}$resolved_lines${C_RESET}"
    else
        echo "  (none)"
    fi
}

# Collect every file we might need to touch: network link/netdev files
# with DNS=, plus resolved.conf and any drop-ins under resolved.conf.d/
collect_target_files() {
    find "$NETWORK_DIR" -maxdepth 1 -type f -print0 2>/dev/null
    [ -f "$RESOLVED_CONF" ] && printf '%s\0' "$RESOLVED_CONF"
    if [ -d "$RESOLVED_CONF_D" ]; then
        find "$RESOLVED_CONF_D" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null
    fi
}

backup_file() {
    local f="$1"
    mkdir -p "$BACKUP_DIR"
    # Encode the full path into the backup filename so restore is unambiguous
    local enc="${f//\//__}"
    cp "$f" "$BACKUP_DIR/$enc.bak"
}

disable_dns() {
    require_root "off"
    mkdir -p "$BACKUP_DIR"

    local found=0
    while IFS= read -r -d '' f; do
        if grep -qE "^(DNS|FallbackDNS)=" "$f" 2>/dev/null; then
            found=1
            echo "Backing up $f"
            backup_file "$f"
            echo "Commenting out DNS=/FallbackDNS= lines in $f"
            sed -i -E 's/^(DNS|FallbackDNS)=/#&/' "$f"
        fi
    done < <(collect_target_files)

    save_state "off"

    if [ "$found" -eq 0 ]; then
        echo "No active DNS= line found anywhere. Nothing to disable (already off, or no custom DNS configured)."
        exit 0
    fi

    apply_changes
    echo
    echo "${C_RED}${C_BOLD}Done. Cloudflare DNS override disabled${C_RESET} — system now uses DHCP-provided / router DNS."
    echo "This preference is saved and will be re-applied automatically on next boot."
    show_status
}

restore_dns() {
    require_root "on"
    if [ ! -d "$BACKUP_DIR" ] || [ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
        echo "No backups found. Nothing to restore (did you run '$PROG_NAME off' first?)."
        exit 1
    fi

    for bak in "$BACKUP_DIR"/*.bak; do
        [ -e "$bak" ] || continue
        local enc target
        enc="$(basename "$bak" .bak)"
        if [[ "$enc" == *__* ]]; then
            target="${enc//__//}"
        else
            # Legacy backup from an older script version: filename only,
            # no path encoding. Assume it belongs under NETWORK_DIR rather
            # than risk writing to a relative path in the caller's cwd.
            target="$NETWORK_DIR/$enc"
            echo "Warning: legacy backup name '$enc' detected; assuming target $target"
        fi
        case "$target" in
            /*) ;;
            *) echo "Skipping unsafe non-absolute target for $bak"; continue ;;
        esac
        mkdir -p "$(dirname "$target")"
        echo "Restoring $target from $bak"
        cp "$bak" "$target"
    done

    save_state "on"

    apply_changes
    echo
    echo "${C_GREEN}${C_BOLD}Done. Cloudflare DNS override restored.${C_RESET}"
    echo "This preference is saved and will be re-applied automatically on next boot."
    show_status
}

# Called by the cloudflare-switch-restore.service unit at boot, after the
# network is up. Silently re-applies whatever the user last chose (on/off)
# WITHOUT touching state again, so a fresh boot that reset the config back
# to its defaults (e.g. NetworkManager/generator/package update rewriting
# the .network files) gets corrected automatically instead of surprising
# you with Cloudflare being back on.
apply_state() {
    require_root "apply-state"
    if [ ! -f "$STATE_FILE" ]; then
        # No saved preference yet (script never used, or only "status" ever
        # run) -> do nothing, leave the system as-is.
        exit 0
    fi

    local wanted
    wanted="$(cat "$STATE_FILE")"

    case "$wanted" in
        off)
            # Only actually do work if something is still/again active.
            if grep -rqE "^(DNS|FallbackDNS)=" "$NETWORK_DIR" "$RESOLVED_CONF" "$RESOLVED_CONF_D" 2>/dev/null; then
                echo "[cloudflare-switch] Saved preference is 'off' but override is active — re-disabling."
                # Reuse disable_dns's file-editing logic, but don't recurse
                # into save_state/exit-on-found logic messaging twice.
                local f found=0
                while IFS= read -r -d '' f; do
                    if grep -qE "^(DNS|FallbackDNS)=" "$f" 2>/dev/null; then
                        found=1
                        backup_file "$f"
                        sed -i -E 's/^(DNS|FallbackDNS)=/#&/' "$f"
                    fi
                done < <(collect_target_files)
                [ "$found" -eq 1 ] && apply_changes
            fi
            ;;
        on)
            if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
                if ! grep -rqE "^(DNS|FallbackDNS)=" "$NETWORK_DIR" "$RESOLVED_CONF" "$RESOLVED_CONF_D" 2>/dev/null; then
                    echo "[cloudflare-switch] Saved preference is 'on' but override is inactive — re-enabling."
                    local bak enc target
                    for bak in "$BACKUP_DIR"/*.bak; do
                        [ -e "$bak" ] || continue
                        enc="$(basename "$bak" .bak)"
                        if [[ "$enc" == *__* ]]; then
                            target="${enc//__//}"
                        else
                            target="$NETWORK_DIR/$enc"
                        fi
                        case "$target" in /*) ;; *) continue ;; esac
                        mkdir -p "$(dirname "$target")"
                        cp "$bak" "$target"
                    done
                    apply_changes
                fi
            fi
            ;;
    esac
}

doctor() {
    show_status
    echo
    echo "===== Sanity checks ====="
    echo "-- resolvectl global DNS:"
    resolvectl dns 2>/dev/null || true
    echo
    echo "-- /etc/resolv.conf target:"
    readlink -f /etc/resolv.conf 2>/dev/null || true
    echo
    echo "-- Quick resolution test (google.com):"
    if command -v dig &>/dev/null; then
        dig +short google.com || echo "  resolution failed"
    else
        getent hosts google.com || echo "  resolution failed"
    fi
    echo
    echo "Note: browsers (Chrome/Firefox) may use their own Secure DNS (DoH)"
    echo "independent of system settings. Check chrome://settings/security"
    echo "or Firefox Network Settings if a site behaves differently in-browser"
    echo "than via 'dig'/'curl' on the command line."
}

usage() {
    echo "Usage: $PROG_NAME {status|on|off|doctor}"
    echo
    echo "  Toggles the Cloudflare DNS override (1.1.1.3 / 1.0.0.3) on this machine."
    echo
    echo "  status   Show whether the Cloudflare override is ACTIVE or INACTIVE (no root)"
    echo "  on       Enable/restore the Cloudflare override               (needs sudo)"
    echo "  off      Disable Cloudflare override, fall back to router/DHCP DNS  (needs sudo)"
    echo "  doctor   Run status + extra sanity checks (no root needed)"
    echo
    echo "Your last choice (on/off) is saved and re-applied automatically at boot"
    echo "if this system's network setup ever resets it (see cloudflare-switch-restore.service)."
}

require_tools

case "${1:-}" in
    status)
        show_status
        ;;
    off)
        disable_dns
        ;;
    on|restore)
        restore_dns
        ;;
    apply-state)
        apply_state
        ;;
    doctor)
        doctor
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
