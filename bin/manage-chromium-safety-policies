#!/usr/bin/env bash
# manage-chromium-safety-policies  (v3.0.0)
#
# Installs, removes, or checks Chrome/Chromium "managed policies" for
# content safety / family filtering, on any Chromium-based browser on
# any Linux distro (Omarchy, Arch, Debian, Fedora, etc.).
#
# Install:
#   chmod +x manage-chromium-safety-policies
#   sudo install -m 755 manage-chromium-safety-policies /usr/local/bin/manage-chromium-safety-policies
#
# Usage:
#   manage-chromium-safety-policies --help    for full documentation
#
# Full policy reference: https://chromeenterprise.google/policies/

set -euo pipefail

VERSION="3.0.0"
PROG_NAME="$(basename "$0")"
SELF="$(readlink -f "$0")"
ORIG_ARGS=("$@")

# Colors (auto-disabled when not attached to a terminal, e.g. piped/logged)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RED=$'\033[1;31m'
  C_GREEN=$'\033[1;32m'
  C_YELLOW=$'\033[1;33m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""; C_RESET=""
fi

die() { echo "${C_RED}Error:${C_RESET} $*" >&2; exit 1; }

# ----------------------------------------------------------------------------
# LEVEL 1 - Content filtering
# ----------------------------------------------------------------------------
#   ForceGoogleSafeSearch   -> forces SafeSearch on for Google Search.
#   ForceYouTubeRestrict    -> 2 = "Strict" YouTube Restricted Mode.
#   SafeSitesFilterBehavior -> 1 = BlockExplicitContent. Blocks pornographic
#                              sites network-wide via Google's Safe Sites
#                              classifier, regardless of search engine used.
#   DnsOverHttpsMode        -> "off" keeps any DNS-level filter (router,
#                              OpenDNS FamilyShield, etc.) effective, since
#                              DoH would otherwise bypass it.
#   BrowserColorScheme      -> "dark" (cosmetic only).
LEVEL1_FILE="zzz-family-safety-level1-content-filter.json"
read -r -d '' LEVEL1_JSON << 'EOF' || true
{
  "ForceGoogleSafeSearch": true,
  "ForceYouTubeRestrict": 2,
  "SafeSitesFilterBehavior": 1,
  "DnsOverHttpsMode": "off",
  "BrowserColorScheme": "dark"
}
EOF

# ----------------------------------------------------------------------------
# LEVEL 2 - Anti-bypass hardening
# ----------------------------------------------------------------------------
#   IncognitoModeAvailability -> 1 = Incognito disabled (filters usually
#                                still apply there, but this closes the door).
#   BrowserGuestModeEnabled   -> false = no Guest browsing session.
#   BrowserAddPersonEnabled   -> false = can't create a new, unmanaged profile.
#   ExtensionInstallBlocklist -> ["*"] = blocks installing ANY extension,
#                                which covers VPN/proxy/unblocker extensions.
#   ProxySettings             -> locks the browser to the system's proxy
#                                config, so a manual/VPN-style proxy can't
#                                be configured from inside the browser.
#   DeveloperToolsAvailability-> 2 = DevTools completely disabled.
#   AllowDeletingBrowserHistory -> false = history can't be cleared.
#   HttpsOnlyMode             -> "force_enabled" = always upgrade to HTTPS.
LEVEL2_FILE="zzz-family-safety-level2-hardening.json"
read -r -d '' LEVEL2_JSON << 'EOF' || true
{
  "IncognitoModeAvailability": 1,
  "BrowserGuestModeEnabled": false,
  "BrowserAddPersonEnabled": false,
  "ExtensionInstallBlocklist": ["*"],
  "ProxySettings": { "ProxyMode": "system" },
  "DeveloperToolsAvailability": 2,
  "AllowDeletingBrowserHistory": false,
  "HttpsOnlyMode": "force_enabled"
}
EOF

# ----------------------------------------------------------------------------
# LEGACY - filenames used before this script existed / before the
# LEVEL_1/LEVEL_2 split. Kept here only so "remove ALL" and "status" can
# find and clean them up.
#
# LEGACY_STANDALONE_FILES contain ONLY policies this script manages, so
# they can be deleted outright.
#
# LEGACY_MIXED_FILE ("color.json") also contains BrowserThemeColor, which
# belongs to Omarchy (or whatever theme tool set it) and is NOT ours to
# touch. For that file we only strip out LEGACY_MIXED_KEY
# (BrowserColorScheme) and leave everything else in the file untouched.
# ----------------------------------------------------------------------------
LEGACY_STANDALONE_FILES=(
  "zzz-family-safety-policies.json"
  "dns-family.json"
  "safe-search.json"
)
LEGACY_MIXED_FILE="color.json"
LEGACY_MIXED_KEY="BrowserColorScheme"

# browser key -> "binary_to_detect:managed_policies_dir"
declare -A BROWSERS=(
  [chromium]="chromium:/etc/chromium/policies/managed"
  [chromium-browser]="chromium-browser:/etc/chromium-browser/policies/managed"
  [google-chrome]="google-chrome-stable:/etc/opt/chrome/policies/managed"
  [google-chrome-beta]="google-chrome-beta:/etc/opt/chrome-beta/policies/managed"
  [brave]="brave-browser:/etc/brave/policies/managed"
  [vivaldi]="vivaldi-stable:/etc/vivaldi/policies/managed"
  [microsoft-edge]="microsoft-edge-stable:/etc/opt/edge/policies/managed"
)

# Some setups (e.g. a theming tool re-applying config on every boot) mark
# their managed policy files as immutable (chattr +i), which makes even
# root's `rm`/write fail with "Operation not permitted". Clear that flag
# before touching a file; a no-op (and silent) everywhere else.
clear_immutable() {
  local f="$1"
  command -v chattr >/dev/null 2>&1 && chattr -i "$f" 2>/dev/null
  return 0
}

# Re-executes this same script under sudo, preserving the original
# arguments, so the person never has to type "sudo" themselves for
# install/remove. Falls through untouched if already root.
need_root() {
  if [ "$(id -u)" -eq 0 ]; then
    return 0
  fi
  if command -v sudo >/dev/null 2>&1; then
    exec sudo -- "${BASH:-bash}" "$SELF" "${ORIG_ARGS[@]}"
  fi
  die "this action needs root and 'sudo' was not found. Try: su -c '$PROG_NAME ${ORIG_ARGS[*]}'"
}

# Short usage shown on a wrong/missing command (stderr, exit 1).
usage() {
  cat >&2 << USAGE
Usage: $PROG_NAME <command> [level]

  install LEVEL_1|LEVEL_2|ALL   Install policies for the given level(s)
  remove  LEVEL_1|LEVEL_2|ALL   Remove policies for the given level(s)
  status                        Show what is currently installed
  -h, --help                    Full documentation
  -v, --version                 Print version

Run '$PROG_NAME --help' for full documentation.
USAGE
  exit 1
}

# Full documentation shown on -h/--help/help (stdout, exit 0).
show_help() {
  cat << HELP
${C_BOLD}$PROG_NAME${C_RESET} $VERSION

Manage Chrome/Chromium "managed policy" files for content-safety and
family filtering, on any Chromium-based browser on any Linux distro.
Auto-detects which browsers are installed and applies to all of them.

${C_BOLD}USAGE${C_RESET}
  $PROG_NAME <command> [level]

${C_BOLD}COMMANDS${C_RESET}
  install LEVEL_1|LEVEL_2|ALL   Install policies for the given level(s)
                                (root needed - sudo is invoked automatically)
  remove  LEVEL_1|LEVEL_2|ALL   Remove policies for the given level(s).
                                'remove ALL' also cleans up legacy files
                                left over from earlier versions of this tool.
  status                        Show what is currently installed on every
                                detected browser. No root needed.
  -h, --help                    Show this help and exit.
  -v, --version                 Show version and exit.

  Levels are case-insensitive: 'level_1' works the same as 'LEVEL_1'.

${C_BOLD}LEVELS${C_RESET}
  ${C_GREEN}LEVEL_1${C_RESET}  Content filtering
    - ForceGoogleSafeSearch    : forces SafeSearch on for Google Search
    - ForceYouTubeRestrict     : 2 = Strict YouTube Restricted Mode
    - SafeSitesFilterBehavior  : 1 = blocks explicit/pornographic sites
                                 network-wide via Google's Safe Sites
                                 classifier, regardless of search engine
    - DnsOverHttpsMode         : "off" - keeps any DNS-level filter (a
                                 router, Cloudflare Family DNS, etc.)
                                 effective, since Secure DNS would
                                 otherwise bypass it
    - BrowserColorScheme       : "dark" (cosmetic only)

  ${C_YELLOW}LEVEL_2${C_RESET}  Anti-bypass hardening
    - IncognitoModeAvailability  : Incognito mode disabled
    - BrowserGuestModeEnabled    : Guest browsing disabled
    - BrowserAddPersonEnabled    : can't create a new, unmanaged profile
    - ExtensionInstallBlocklist  : blocks installing ANY extension,
                                   including VPN/proxy/unblocker ones
    - ProxySettings              : locks the browser to the system's
                                   proxy config (no manual/VPN-style
                                   proxy from inside the browser)
    - DeveloperToolsAvailability : DevTools completely disabled
    - AllowDeletingBrowserHistory: history can't be cleared
    - HttpsOnlyMode              : always upgrades HTTP to HTTPS

${C_BOLD}SUPPORTED BROWSERS${C_RESET} (auto-detected, all get the same policy)
  chromium, chromium-browser, google-chrome, google-chrome-beta,
  brave, vivaldi, microsoft-edge

${C_BOLD}NOTES${C_RESET}
  - Chrome policies only control the BROWSER. LEVEL_2 blocks VPN/proxy
    browser EXTENSIONS and locks the browser's own proxy setting, but it
    CANNOT block a standalone VPN application running at the OS level -
    that traffic never goes through Chrome's policy engine.
  - After install/remove, open chrome://policy and click 'Reload policies'
    to confirm the change took effect.
  - 'remove ALL' also cleans up legacy policy files from earlier versions
    of this tool (a single combined file, or separate dns-family.json /
    safe-search.json files). If a shared color.json also has a
    BrowserThemeColor key (e.g. set by a theming tool), only this tool's
    own BrowserColorScheme key is stripped out - BrowserThemeColor is
    left untouched.
  - Managed policy files marked immutable (chattr +i by some other tool)
    are automatically unlocked before being modified or removed.

${C_BOLD}EXAMPLES${C_RESET}
  $PROG_NAME install LEVEL_1
  $PROG_NAME install ALL
  $PROG_NAME status
  $PROG_NAME remove ALL

Full Chrome policy reference: https://chromeenterprise.google/policies/
HELP
  exit 0
}

# Returns "key:dir" for every browser that looks installed on this machine.
detect_installed() {
  local found=0
  for key in "${!BROWSERS[@]}"; do
    IFS=':' read -r bin dir <<< "${BROWSERS[$key]}"
    if command -v "$bin" >/dev/null 2>&1 || [ -d "$(dirname "$dir")" ]; then
      echo "$key:$dir"
      found=1
    fi
  done
  [ "$found" -eq 0 ] && echo ""
  return 0
}

file_and_json_for_level() {
  case "$1" in
    LEVEL_1) echo "$LEVEL1_FILE"; echo "$LEVEL1_JSON" ;;
    LEVEL_2) echo "$LEVEL2_FILE"; echo "$LEVEL2_JSON" ;;
    *) die "Unknown level: $1 (expected LEVEL_1, LEVEL_2, or ALL)" ;;
  esac
}

install_level() {
  local level="$1"
  local file json any=0
  file=$(file_and_json_for_level "$level" | sed -n 1p)
  json=$(file_and_json_for_level "$level" | tail -n +2)

  while IFS=':' read -r key dir; do
    [ -z "$key" ] && continue
    any=1
    mkdir -p "$dir"
    clear_immutable "$dir/$file"
    printf '%s\n' "$json" > "$dir/$file"
    chmod 644 "$dir/$file"
    echo "${C_GREEN}[+]${C_RESET} $level installed for $key -> $dir/$file"
  done < <(detect_installed)

  if [ "$any" -eq 0 ]; then
    die "No Chromium-based browser detected on this system."
  fi
}

remove_level() {
  local level="$1"
  local file any=0
  file=$(file_and_json_for_level "$level" | sed -n 1p)

  for key in "${!BROWSERS[@]}"; do
    IFS=':' read -r bin dir <<< "${BROWSERS[$key]}"
    target="$dir/$file"
    if [ -f "$target" ]; then
      clear_immutable "$target"
      rm -f "$target"
      echo "${C_RED}[-]${C_RESET} $level removed for $key -> $target"
      any=1
    fi
  done

  [ "$any" -eq 0 ] && echo "$level was not installed, nothing to remove."
}

# Strips LEGACY_MIXED_KEY out of a color.json-style file while preserving
# every other key (e.g. BrowserThemeColor) untouched. Deletes the file only
# if nothing else is left in it. Requires python3.
strip_mixed_key() {
  local target="$1"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "${C_YELLOW}[!]${C_RESET} python3 not found - please remove \"$LEGACY_MIXED_KEY\" from $target by hand." >&2
    return
  fi
  clear_immutable "$target"
  python3 - "$target" "$LEGACY_MIXED_KEY" << 'PY'
import json, sys
path, key = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
removed = data.pop(key, None)
if removed is None:
    sys.exit(0)
if data:
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    print(f"kept:{path}")
else:
    import os
    os.remove(path)
    print(f"deleted:{path}")
PY
}

# Cleans up leftovers from before this script existed.
remove_legacy() {
  local any=0
  for key in "${!BROWSERS[@]}"; do
    IFS=':' read -r bin dir <<< "${BROWSERS[$key]}"

    for fname in "${LEGACY_STANDALONE_FILES[@]}"; do
      target="$dir/$fname"
      if [ -f "$target" ]; then
        clear_immutable "$target"
        rm -f "$target"
        echo "${C_RED}[-]${C_RESET} LEGACY removed for $key -> $target"
        any=1
      fi
    done

    mixed="$dir/$LEGACY_MIXED_FILE"
    if [ -f "$mixed" ] && grep -q "\"$LEGACY_MIXED_KEY\"" "$mixed" 2>/dev/null; then
      result=$(strip_mixed_key "$mixed")
      case "$result" in
        kept:*)    echo "${C_RED}[-]${C_RESET} LEGACY key \"$LEGACY_MIXED_KEY\" removed from $key -> $mixed (other keys kept, e.g. BrowserThemeColor)"; any=1 ;;
        deleted:*) echo "${C_RED}[-]${C_RESET} LEGACY removed for $key -> $mixed (file was empty afterwards)"; any=1 ;;
      esac
    fi
  done
  [ "$any" -eq 1 ] && echo "(These were leftovers from before this script existed.)"
}

cmd_install() {
  local level="${1:-}"
  [ -z "$level" ] && usage
  level="${level^^}"
  need_root
  case "$level" in
    ALL) install_level LEVEL_1; install_level LEVEL_2 ;;
    LEVEL_1|LEVEL_2) install_level "$level" ;;
    *) usage ;;
  esac
  echo
  echo "${C_BOLD}Done.${C_RESET} Open chrome://policy and click 'Reload policies' to confirm."
}

cmd_remove() {
  local level="${1:-}"
  [ -z "$level" ] && usage
  level="${level^^}"
  need_root
  case "$level" in
    ALL) remove_level LEVEL_1; remove_level LEVEL_2; remove_legacy ;;
    LEVEL_1|LEVEL_2) remove_level "$level" ;;
    *) usage ;;
  esac
  echo
  echo "${C_BOLD}Done.${C_RESET} Open chrome://policy and click 'Reload policies' to confirm."
}

cmd_status() {
  local any=0
  for key in "${!BROWSERS[@]}"; do
    IFS=':' read -r bin dir <<< "${BROWSERS[$key]}"
    if ! command -v "$bin" >/dev/null 2>&1 && [ ! -d "$dir" ]; then
      continue
    fi
    any=1
    l1_status="${C_YELLOW}not set${C_RESET}"; [ -f "$dir/$LEVEL1_FILE" ] && l1_status="${C_GREEN}ENABLED${C_RESET}"
    l2_status="${C_YELLOW}not set${C_RESET}"; [ -f "$dir/$LEVEL2_FILE" ] && l2_status="${C_GREEN}ENABLED${C_RESET}"
    echo "${C_BOLD}$key${C_RESET}:"
    echo -e "  LEVEL_1 (content filter): $l1_status"
    echo -e "  LEVEL_2 (hardening):      $l2_status"
    for fname in "${LEGACY_STANDALONE_FILES[@]}"; do
      if [ -f "$dir/$fname" ]; then
        echo "  ${C_YELLOW}LEGACY file found:${C_RESET}        $dir/$fname  - run '$PROG_NAME remove ALL' to clean it up"
      fi
    done
    mixed="$dir/$LEGACY_MIXED_FILE"
    if [ -f "$mixed" ] && grep -q "\"$LEGACY_MIXED_KEY\"" "$mixed" 2>/dev/null; then
      echo "  ${C_YELLOW}LEGACY key found:${C_RESET}         \"$LEGACY_MIXED_KEY\" inside $mixed  - run '$PROG_NAME remove ALL' to clean it up (BrowserThemeColor there is kept)"
    fi
  done
  [ "$any" -eq 0 ] && echo "No Chromium-based browser detected on this system."
}

case "${1:-}" in
  install)        cmd_install "${2:-}" ;;
  remove)         cmd_remove "${2:-}" ;;
  status)         cmd_status ;;
  -h|--help|help) show_help ;;
  -v|--version|version) echo "$PROG_NAME $VERSION" ;;
  "")             usage ;;
  *)              echo "${C_RED}Unknown command:${C_RESET} $1" >&2; usage ;;
esac
