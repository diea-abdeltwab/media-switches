#!/usr/bin/env python3
"""
toggle-omarchy-bar-icons.py

Hides/shows the "omarchy.network" and "omarchy.monitor" entries in
~/.config/omarchy/shell.json (the "right" section of the bar layout),
without touching "omarchy.audio" or any other entry.

Usage:
    ./toggle-omarchy-bar-icons.py
"""

import json
import os
import subprocess
import sys

CONFIG_PATH = os.path.expanduser("~/.config/omarchy/shell.json")

# Which entries to toggle, and where to re-insert them if they're missing
# (inserted right before this anchor id, falling back to the end of the list).
TARGETS = ["omarchy.network", "omarchy.monitor"]
INSERT_BEFORE = "omarchy.power"


def load_config(path):
    if not os.path.isfile(path):
        print(f"Config file not found: {path}")
        sys.exit(1)
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_config(path, data):
    backup_path = path + ".bak"
    with open(path, "r", encoding="utf-8") as f:
        original = f.read()
    with open(backup_path, "w", encoding="utf-8") as f:
        f.write(original)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def entry_id(entry):
    if isinstance(entry, str):
        return entry
    if isinstance(entry, dict):
        return entry.get("id", "")
    return ""


def main():
    config = load_config(CONFIG_PATH)

    try:
        right = config["bar"]["layout"]["right"]
    except (KeyError, TypeError):
        print('Could not find bar.layout.right in shell.json')
        sys.exit(1)

    ids_present = [entry_id(e) for e in right]

    for target in TARGETS:
        if target in ids_present:
            # Currently visible -> remove it (hide)
            right[:] = [e for e in right if entry_id(e) != target]
            print(f"Hidden: {target}")
        else:
            # Currently hidden -> add it back
            new_entry = {"id": target}
            insert_index = len(right)
            for i, e in enumerate(right):
                if entry_id(e) == INSERT_BEFORE:
                    insert_index = i
                    break
            right.insert(insert_index, new_entry)
            print(f"Shown: {target}")

    config["bar"]["layout"]["right"] = right
    save_config(CONFIG_PATH, config)

    # Try to reload the bar so the change takes effect immediately.
    # Adjust this if your setup uses a different reload command.
    reloaded = False
    for cmd in (
        ["omarchy-restart-bar"],
        ["systemctl", "--user", "restart", "omarchy-shell"],
    ):
        try:
            subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            reloaded = True
            print(f"Reloaded via: {' '.join(cmd)}")
            break
        except (subprocess.CalledProcessError, FileNotFoundError):
            continue

    if not reloaded:
        print("Could not auto-reload the bar. Please reload it manually")
        print("(e.g. restart Quickshell/Omarchy shell, or log out and back in).")


if __name__ == "__main__":
    main()
