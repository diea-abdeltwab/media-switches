#!/usr/bin/env bash
# social-switch  (v2)
# Block/unblock social media sites system-wide via /etc/hosts.
#
# Model: every platform is independently blocked or allowed. The list of
# platforms you WANT blocked is the single source of truth
# (/etc/social-switch/blocked); /etc/hosts is generated from it.
#
# Install:
#   sudo install -m 755 social-switch /usr/local/bin/social-switch
#
# Usage:
#   social-switch status [--json]      show per-platform state      (no root)
#   social-switch list                 list platform keys           (no root)
#   social-switch off                  block ALL platforms
#   social-switch off a b              block only a and b (others untouched)
#   social-switch off --except a,b     block everything except a and b
#   social-switch on                   allow ALL platforms
#   social-switch on a b               allow only a and b (others untouched)
#   social-switch block|unblock a b    same as off|on, platforms required
#   social-switch sync                 re-apply saved state to /etc/hosts
#   social-switch doctor               diagnose problems            (no root)
#
# Commands that change things re-run themselves through sudo automatically.
# Wording: "on" = social media is ON (allowed), "off" = OFF (blocked).

set -euo pipefail

VERSION="2.0.0"
HOSTS="/etc/hosts"
BACKUP="/etc/hosts.bak"
IP4="0.0.0.0"
IP6="::"
CONFIG_DIR="/etc/social-switch"
BLOCKED_FILE="$CONFIG_DIR/blocked"
LEGACY_STATE_FILE="$CONFIG_DIR/state"      # v1, migrated automatically
LEGACY_EXCLUDE_FILE="$CONFIG_DIR/exclude"  # v1, migrated automatically
LOCK_FILE="/run/social-switch.lock"
BEGIN_MARK="# BEGIN social-switch managed block - do not edit below"
END_MARK="# END social-switch managed block"
PROG_NAME="$(basename "$0")"
SELF="$(readlink -f "$0")"
ORIG_ARGS=("$@")

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$'\033[1;31m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""; C_RESET=""
fi

declare -A PLATFORM_LABEL=(
    [facebook]="Facebook"
    [messenger]="Messenger"
    [instagram]="Instagram"
    [threads]="Threads"
    [twitter]="X / Twitter"
    [tiktok]="TikTok"
    [reddit]="Reddit"
    [snapchat]="Snapchat"
    [pinterest]="Pinterest"
    [tumblr]="Tumblr"
    [discord]="Discord"
    [twitch]="Twitch"
)

declare -A PLATFORM_DOMAINS=(
    [facebook]="facebook.com www.facebook.com m.facebook.com mbasic.facebook.com mobile.facebook.com fb.com www.fb.com"
    [messenger]="messenger.com www.messenger.com"
    [instagram]="instagram.com www.instagram.com"
    [threads]="threads.net www.threads.net"
    [twitter]="x.com www.x.com twitter.com www.twitter.com mobile.twitter.com tweetdeck.twitter.com"
    [tiktok]="tiktok.com www.tiktok.com m.tiktok.com vm.tiktok.com vt.tiktok.com"
    [reddit]="reddit.com www.reddit.com old.reddit.com new.reddit.com np.reddit.com amp.reddit.com"
    [snapchat]="snapchat.com www.snapchat.com web.snapchat.com"
    [pinterest]="pinterest.com www.pinterest.com pin.it"
    [tumblr]="tumblr.com www.tumblr.com"
    [discord]="discord.com www.discord.com discord.gg discordapp.com www.discordapp.com gateway.discord.gg cdn.discordapp.com media.discordapp.net"
    [twitch]="twitch.tv www.twitch.tv m.twitch.tv api.twitch.tv gql.twitch.tv player.twitch.tv clips.twitch.tv static.twitchcdn.net assets.twitch.tv"
)

# Bash associative arrays have no order, so keep an explicit display order.
PLATFORM_ORDER=(facebook messenger instagram threads twitter tiktok reddit snapchat pinterest tumblr discord twitch)

# --- small helpers ---------------------------------------------------------
# NOTE on `set -e`: a function returns the exit status of its LAST command.
# Helpers that end with `[ ... ] && ...` or a loop can therefore "fail" by
# accident and kill the whole script. Such helpers end with an explicit
# `return 0`.

die()  { echo "${C_RED}Error:${C_RESET} $*" >&2; exit 1; }
warn() { echo "${C_YELLOW}Warning:${C_RESET} $*" >&2; }

TMPFILES=()
HOSTS_WAS_IMMUTABLE=0
HOSTS_UNLOCKED=0

cleanup() {
    local f
    if [ "${#TMPFILES[@]}" -gt 0 ]; then
        for f in "${TMPFILES[@]}"; do rm -f -- "$f"; done
    fi
    # If we removed the immutable flag and died before finishing, put it back.
    if [ "$HOSTS_UNLOCKED" -eq 1 ] && [ "$HOSTS_WAS_IMMUTABLE" -eq 1 ]; then
        chattr +i "$HOSTS" 2>/dev/null || true
    fi
    return 0
}
trap cleanup EXIT

# Runs in the current shell (not a subshell) so TMPFILES tracking works.
new_tmp() {
    NEW_TMP="$(mktemp "$1.tmp.XXXXXX")"
    TMPFILES+=("$NEW_TMP")
}

# atomic_write <dest> <mode>   (content on stdin)
# Write to a temp file in the same directory, then rename: readers never
# see a half-written file.
atomic_write() {
    local dest="$1" mode="$2" tmp
    new_tmp "$dest"
    tmp="$NEW_TMP"
    cat > "$tmp"
    chmod "$mode" "$tmp"
    mv -f -- "$tmp" "$dest"
}

need_root() {
    if [ "$EUID" -eq 0 ]; then
        return 0
    fi
    if command -v sudo >/dev/null 2>&1; then
        exec sudo -- "$BASH" "$SELF" "${ORIG_ARGS[@]}"
    fi
    die "this action needs root and 'sudo' was not found."
}

acquire_lock() {
    exec 9>"$LOCK_FILE" || die "cannot open lock file $LOCK_FILE"
    flock -w 15 9 || die "another $PROG_NAME is running (lock: $LOCK_FILE)"
}

in_list() {
    local needle="$1" x
    shift
    for x in "$@"; do
        if [ "$x" = "$needle" ]; then return 0; fi
    done
    return 1
}

normalize_key() {
    local k="${1,,}"
    k="${k//[[:space:]]/}"
    case "$k" in
        x|xcom)     k="twitter" ;;
        fb)         k="facebook" ;;
        ig|insta)   k="instagram" ;;
    esac
    printf '%s' "$k"
}

is_valid_platform() {
    [[ "${1:-}" =~ ^[a-z0-9_-]+$ ]] && [ -n "${PLATFORM_LABEL[$1]+x}" ]
}

all_domains() {
    local key out=""
    for key in "${PLATFORM_ORDER[@]}"; do
        out+="${PLATFORM_DOMAINS[$key]} "
    done
    printf '%s' "$out"
}

valid_keys_hint() {
    echo "Valid platforms: ${PLATFORM_ORDER[*]}" >&2
}

# --- saved state (the "blocked" list) ---------------------------------------

BLOCKED=()

in_blocked() {
    in_list "$1" "${BLOCKED[@]}"
}

# Build BLOCKED (canonical order, no duplicates) from the keys given as args.
set_blocked_from() {
    local -a want=("$@")
    local key
    BLOCKED=()
    for key in "${PLATFORM_ORDER[@]}"; do
        if in_list "$key" "${want[@]}"; then BLOCKED+=("$key"); fi
    done
    return 0
}

load_blocked() {
    BLOCKED=()
    local line key
    if [ -f "$BLOCKED_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            key="$(normalize_key "$line")"
            [ -n "$key" ] || continue
            is_valid_platform "$key" || continue
            in_blocked "$key" || BLOCKED+=("$key")
        done < "$BLOCKED_FILE"
    elif [ -f "$LEGACY_STATE_FILE" ] && [ "$(<"$LEGACY_STATE_FILE")" = "off" ]; then
        # v1 -> v2 migration: "off" meant everything except the exclude list.
        local -a legacy_ex=()
        if [ -f "$LEGACY_EXCLUDE_FILE" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                key="$(normalize_key "$line")"
                [ -n "$key" ] || continue
                legacy_ex+=("$key")
            done < "$LEGACY_EXCLUDE_FILE"
        fi
        for key in "${PLATFORM_ORDER[@]}"; do
            in_list "$key" "${legacy_ex[@]}" || BLOCKED+=("$key")
        done
    fi
    return 0
}

save_blocked() {
    mkdir -p "$CONFIG_DIR"
    if [ "${#BLOCKED[@]}" -gt 0 ]; then
        printf '%s\n' "${BLOCKED[@]}" | atomic_write "$BLOCKED_FILE" 644
    else
        : | atomic_write "$BLOCKED_FILE" 644
    fi
    rm -f -- "$LEGACY_STATE_FILE" "$LEGACY_EXCLUDE_FILE"
}

# --- /etc/hosts editing ------------------------------------------------------

is_immutable() {
    local attrs
    attrs="$(lsattr -d "$HOSTS" 2>/dev/null | awk '{print $1}')" || return 1
    [[ "$attrs" == *i* ]]
}

flush_dns() {
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl flush-caches >/dev/null 2>&1 || true
    elif command -v systemd-resolve >/dev/null 2>&1; then
        systemd-resolve --flush-caches >/dev/null 2>&1 || true
    fi
    if command -v nscd >/dev/null 2>&1; then
        nscd -i hosts >/dev/null 2>&1 || true
    fi
    return 0
}

# BEGIN/END markers must be balanced. Otherwise an unterminated BEGIN would
# make the awk filter below swallow the rest of the file.
hosts_markers_ok() {
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
        $0 == b { if (open) bad = 1; open = 1; next }
        $0 == e { if (!open) bad = 1; open = 0; next }
        END { exit ((bad || open) ? 1 : 0) }
    ' "$HOSTS"
}

managed_block() {
    local key domain
    echo "$BEGIN_MARK"
    for key in "${BLOCKED[@]}"; do
        echo "# ${PLATFORM_LABEL[$key]}"
        for domain in ${PLATFORM_DOMAINS[$key]}; do
            echo "$IP4 $domain"
            echo "$IP6 $domain"     # IPv6 too, so AAAA lookups can't leak
        done
    done
    echo "$END_MARK"
}

# Print the new /etc/hosts to stdout, in ONE pass over the file:
#   1. drop our old managed block (exact line match, no regex)
#   2. drop stray "0.0.0.0/:: <known domain(s)>" lines left by older
#      versions or added by hand (they'd defeat "allow"). A line is only
#      dropped if EVERY hostname on it is one of ours.
#   3. append the fresh managed block
build_hosts_content() {
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v ip4="$IP4" -v ip6="$IP6" \
        -v doms="$(all_domains)" '
        BEGIN { n = split(doms, arr, " "); for (i = 1; i <= n; i++) known[arr[i]] = 1 }
        $0 == b { skip = 1; next }
        $0 == e { skip = 0; next }
        skip    { next }
        {
            line = $0
            sub(/[ \t]*#.*$/, "", line)
            m = split(line, f, " ")
            if (m >= 2 && (f[1] == ip4 || f[1] == ip6)) {
                all = 1
                for (i = 2; i <= m; i++) if (!(f[i] in known)) { all = 0; break }
                if (all) next
            }
            print
        }
    ' "$HOSTS"
    if [ "${#BLOCKED[@]}" -gt 0 ]; then
        managed_block
    fi
}

apply_hosts() {
    [ -f "$HOSTS" ] || die "$HOSTS not found"
    hosts_markers_ok || die "the social-switch markers in $HOSTS are unbalanced; refusing to edit. Fix it by hand (see $BACKUP)."

    [ -f "$BACKUP" ] || cp -p -- "$HOSTS" "$BACKUP"

    local tmp
    new_tmp "$HOSTS"
    tmp="$NEW_TMP"
    build_hosts_content > "$tmp"

    # Sanity checks before touching the real file.
    [ -s "$tmp" ] || die "generated hosts file is empty; aborting (nothing changed)."
    if grep -q 'localhost' "$HOSTS" && ! grep -q 'localhost' "$tmp"; then
        die "generated hosts file lost its localhost entry; aborting (nothing changed)."
    fi

    chmod --reference="$HOSTS" "$tmp"
    chown --reference="$HOSTS" "$tmp" 2>/dev/null || true

    if is_immutable; then
        HOSTS_WAS_IMMUTABLE=1
        chattr -i "$HOSTS" || die "cannot clear the immutable flag on $HOSTS"
        HOSTS_UNLOCKED=1
    fi

    if ! mv -f -- "$tmp" "$HOSTS" 2>/dev/null; then
        # e.g. /etc/hosts is a bind mount (containers): rename impossible.
        cat "$tmp" > "$HOSTS" || die "cannot write $HOSTS"
    fi
    HOSTS_UNLOCKED=0

    # Lock only while something is blocked, so "on" leaves the file editable.
    if [ "${#BLOCKED[@]}" -gt 0 ]; then
        chattr +i "$HOSTS" 2>/dev/null \
            || warn "could not set the immutable flag on $HOSTS (unsupported filesystem?)"
    fi
    flush_dns
}

# --- effective state (what /etc/hosts really does) ---------------------------

declare -A ACTIVE=()

load_active() {
    ACTIVE=()
    local d
    while IFS= read -r d; do
        [ -n "$d" ] && ACTIVE["$d"]=1
    done < <(awk -v ip4="$IP4" -v doms="$(all_domains)" '
        BEGIN { n = split(doms, arr, " "); for (i = 1; i <= n; i++) known[arr[i]] = 1 }
        {
            line = $0
            sub(/[ \t]*#.*$/, "", line)
            m = split(line, f, " ")
            if (m >= 2 && f[1] == ip4)
                for (i = 2; i <= m; i++) if (f[i] in known) seen[f[i]] = 1
        }
        END { for (d in seen) print d }
    ' "$HOSTS" 2>/dev/null)
    return 0
}

# full | partial | none  -- how many of the platform's domains are 0.0.0.0
effective_state() {
    local key="$1" d total=0 hit=0
    for d in ${PLATFORM_DOMAINS[$key]}; do
        total=$((total + 1))
        if [ -n "${ACTIVE[$d]+x}" ]; then hit=$((hit + 1)); fi
    done
    if [ "$hit" -eq "$total" ]; then echo full
    elif [ "$hit" -gt 0 ]; then echo partial
    else echo none
    fi
}

# blocked  = wanted and applied        allowed  = not wanted, not blocked
# broken   = wanted but not applied    external = not wanted, blocked anyway
row_status() {
    local key="$1" eff
    eff="$(effective_state "$key")"
    if in_blocked "$key"; then
        if [ "$eff" = full ]; then echo blocked; else echo broken; fi
    else
        if [ "$eff" = none ]; then echo allowed; else echo external; fi
    fi
}

# --- commands ---------------------------------------------------------------

cmd_status() {
    local json=0
    case "${1:-}" in
        --json) json=1 ;;
        "")     ;;
        *)      die "unknown option '$1' (usage: $PROG_NAME status [--json])" ;;
    esac

    load_blocked
    load_active

    local key st sample count=0 total="${#PLATFORM_ORDER[@]}"
    local -A rows=()
    for key in "${PLATFORM_ORDER[@]}"; do
        st="$(row_status "$key")"
        rows[$key]="$st"
        if [ "$st" = blocked ]; then count=$((count + 1)); fi
    done

    local overall="mixed"
    if [ "${#BLOCKED[@]}" -eq 0 ]; then overall="on"
    elif [ "${#BLOCKED[@]}" -eq "$total" ]; then overall="off"
    fi

    local locked=false
    if is_immutable; then locked=true; fi

    if [ "$json" -eq 1 ]; then
        local first=1 isb
        printf '{"state":"%s","blocked_count":%d,"total":%d,"immutable":%s,"platforms":[' \
            "$overall" "$count" "$total" "$locked"
        for key in "${PLATFORM_ORDER[@]}"; do
            isb=false
            if [ "${rows[$key]}" = blocked ]; then isb=true; fi
            if [ "$first" -eq 0 ]; then printf ','; fi
            first=0
            printf '{"key":"%s","label":"%s","blocked":%s,"status":"%s"}' \
                "$key" "${PLATFORM_LABEL[$key]}" "$isb" "${rows[$key]}"
        done
        printf ']}\n'
        return 0
    fi

    echo "===== Social Media Block Status ====="
    if grep -qxF "$BEGIN_MARK" "$HOSTS" 2>/dev/null; then
        echo "Managed block in $HOSTS : ${C_YELLOW}yes${C_RESET}"
    else
        echo "Managed block in $HOSTS : ${C_YELLOW}no${C_RESET}"
    fi
    echo "Social media            : ${C_BOLD}${overall}${C_RESET}   (on = allowed, off = blocked)"
    echo "$HOSTS locked (chattr +i): $locked"
    echo

    printf "%-14s %-10s %s\n" "PLATFORM" "STATUS" "SAMPLE DOMAIN"
    local color
    for key in "${PLATFORM_ORDER[@]}"; do
        sample="${PLATFORM_DOMAINS[$key]%% *}"
        case "${rows[$key]}" in
            blocked)  color="$C_RED" ;;
            allowed)  color="$C_GREEN" ;;
            *)        color="$C_YELLOW" ;;
        esac
        printf "%-14s ${color}%-10s${C_RESET} %s\n" "${PLATFORM_LABEL[$key]}" "${rows[$key]}" "$sample"
    done
    echo
    echo "$count / $total platforms currently blocked."

    if [[ " ${rows[*]} " == *" broken "* ]]; then
        echo "${C_YELLOW}broken${C_RESET}   = saved as blocked but missing from $HOSTS -> sudo $PROG_NAME sync"
    fi
    if [[ " ${rows[*]} " == *" external "* ]]; then
        echo "${C_YELLOW}external${C_RESET} = allowed here, but another $HOSTS entry still blocks it -> $PROG_NAME doctor"
    fi
    return 0
}

cmd_list() {
    echo "Available platform keys:"
    local key
    for key in "${PLATFORM_ORDER[@]}"; do
        printf "  %-12s %s\n" "$key" "${PLATFORM_LABEL[$key]}"
    done
}

# cmd_toggle <on|off> [platform...] [--except a,b]
cmd_toggle() {
    local mode="$1"
    shift
    local -a targets=() except=() parts=() next=()
    local arg part key bulk=0

    # 1. Parse and validate BEFORE asking for a password.
    while [ "$#" -gt 0 ]; do
        arg="$1"
        shift
        case "$arg" in
            --except)
                [ "$mode" = off ] || die "--except only works with 'off'"
                [ "$#" -gt 0 ] || die "--except needs a comma-separated list, e.g. --except discord,twitch"
                IFS=',' read -ra parts <<< "$1"
                shift
                for part in "${parts[@]}"; do
                    key="$(normalize_key "$part")"
                    [ -n "$key" ] || continue
                    is_valid_platform "$key" || { valid_keys_hint; die "unknown platform '$part'"; }
                    except+=("$key")
                done
                ;;
            -*)
                die "unknown option '$arg'"
                ;;
            *)
                IFS=',' read -ra parts <<< "$arg"
                for part in "${parts[@]}"; do
                    key="$(normalize_key "$part")"
                    [ -n "$key" ] || continue
                    if [ "$key" = all ]; then
                        bulk=1
                    elif is_valid_platform "$key"; then
                        targets+=("$key")
                    else
                        valid_keys_hint
                        die "unknown platform '$part'"
                    fi
                done
                ;;
        esac
    done
    if [ "${#targets[@]}" -gt 0 ] && [ "${#except[@]}" -gt 0 ]; then
        die "--except can't be combined with explicit platforms"
    fi
    if [ "${#targets[@]}" -eq 0 ]; then bulk=1; fi

    need_root
    acquire_lock
    load_blocked

    # 2. Compute the new wanted-blocked set.
    if [ "$mode" = off ]; then
        if [ "$bulk" -eq 1 ]; then
            for key in "${PLATFORM_ORDER[@]}"; do
                in_list "$key" "${except[@]}" || next+=("$key")
            done
        else
            next=("${BLOCKED[@]}" "${targets[@]}")
        fi
    else
        if [ "$bulk" -eq 0 ]; then
            for key in "${BLOCKED[@]}"; do
                in_list "$key" "${targets[@]}" || next+=("$key")
            done
        fi
    fi
    set_blocked_from "${next[@]}"

    # 3. Persist the intent first, then apply it.
    if [ "$mode" = off ]; then
        if [ "$bulk" -eq 1 ]; then echo "Blocking social media..."
        else echo "Blocking: ${targets[*]}"; fi
    else
        if [ "$bulk" -eq 1 ]; then echo "Unblocking social media..."
        else echo "Allowing: ${targets[*]}"; fi
    fi
    save_blocked
    apply_hosts

    # 4. Report.
    local -a allowed=()
    for key in "${PLATFORM_ORDER[@]}"; do
        in_blocked "$key" || allowed+=("$key")
    done
    echo
    echo "${C_BOLD}Done.${C_RESET} Blocked ${#BLOCKED[@]} / ${#PLATFORM_ORDER[@]} platforms."
    if [ "${#BLOCKED[@]}" -gt 0 ]; then
        echo "  ${C_RED}blocked:${C_RESET} ${BLOCKED[*]}"
    fi
    if [ "${#allowed[@]}" -gt 0 ]; then
        echo "  ${C_GREEN}allowed:${C_RESET} ${allowed[*]}"
    fi
    if [ "$mode" = off ]; then
        echo
        echo "${C_YELLOW}Note:${C_RESET} browsers using Secure DNS / DNS-over-HTTPS bypass $HOSTS."
        echo "Run '$PROG_NAME doctor' to check."
    fi
    echo "Original hosts backup: $BACKUP"
}

cmd_sync() {
    need_root
    acquire_lock
    load_blocked
    echo "Re-applying saved state (${#BLOCKED[@]} blocked platform(s))..."
    apply_hosts
    echo "${C_BOLD}Done.${C_RESET}"
}

# Deprecated v1 commands, kept so old muscle memory and scripts still work.
cmd_except() {
    local action="${1:-list}"
    if [ "$#" -gt 0 ]; then shift; fi
    case "$action" in
        add)
            [ "$#" -ge 1 ] || die "usage: $PROG_NAME except add <platform>..."
            warn "'except add' is deprecated; use: $PROG_NAME on <platform>"
            cmd_toggle on "$@"
            ;;
        remove)
            [ "$#" -ge 1 ] || die "usage: $PROG_NAME except remove <platform>..."
            warn "'except remove' is deprecated; use: $PROG_NAME off <platform>"
            cmd_toggle off "$@"
            ;;
        list)
            load_blocked
            local key found=0
            echo "Platforms currently allowed:"
            for key in "${PLATFORM_ORDER[@]}"; do
                if ! in_blocked "$key"; then
                    printf "  %-12s %s\n" "$key" "${PLATFORM_LABEL[$key]}"
                    found=1
                fi
            done
            if [ "$found" -eq 0 ]; then echo "  (none - everything is blocked)"; fi
            ;;
        *)
            die "usage: $PROG_NAME except {add|remove|list} [platform...]"
            ;;
    esac
}

cmd_doctor() {
    cmd_status
    echo
    echo "===== Sanity checks ====="
    local issues=0 key sample ip

    load_blocked
    load_active

    echo "-- Managed block markers:"
    if hosts_markers_ok; then
        echo "  ok (balanced)"
    else
        echo "  ${C_RED}UNBALANCED BEGIN/END markers in $HOSTS - edits are refused until fixed.${C_RESET}"
        issues=$((issues + 1))
    fi

    echo "-- Duplicate entries for our domains:"
    local dupes
    dupes="$(awk -v ip4="$IP4" -v doms="$(all_domains)" '
        BEGIN { n = split(doms, arr, " "); for (i = 1; i <= n; i++) known[arr[i]] = 1 }
        { line = $0; sub(/[ \t]*#.*$/, "", line); m = split(line, f, " ")
          if (m >= 2 && f[1] == ip4) for (i = 2; i <= m; i++) if (f[i] in known) c[f[i]]++ }
        END { for (d in c) if (c[d] > 1) print "  " c[d] "x " d }
    ' "$HOSTS" | sort)"
    if [ -n "$dupes" ]; then
        echo "${C_YELLOW}$dupes${C_RESET}"
        echo "  Usually a third-party blocklist. Run 'sudo $PROG_NAME sync' to dedupe ours."
        issues=$((issues + 1))
    else
        echo "  none"
    fi

    echo "-- Immutable flag vs. saved state:"
    if [ "${#BLOCKED[@]}" -eq 0 ] && is_immutable; then
        echo "  ${C_YELLOW}$HOSTS is locked but nothing is blocked (left over from an old version).${C_RESET}"
        echo "  Run: sudo $PROG_NAME on"
        issues=$((issues + 1))
    elif [ "${#BLOCKED[@]}" -gt 0 ] && ! is_immutable; then
        echo "  ${C_YELLOW}Blocking is active but $HOSTS is not locked (someone/something can rewrite it).${C_RESET}"
        echo "  Run: sudo $PROG_NAME sync"
        issues=$((issues + 1))
    else
        echo "  consistent"
    fi

    echo "-- Size of $HOSTS:"
    local size
    size="$(stat -c %s "$HOSTS" 2>/dev/null || echo 0)"
    if [ "$size" -gt 2000000 ]; then
        echo "  ${C_YELLOW}$((size / 1024 / 1024)) MB. glibc rescans this whole file on every hostname lookup,${C_RESET}"
        echo "  ${C_YELLOW}which slows down all networking. Consider a resolver-level blocklist${C_RESET}"
        echo "  ${C_YELLOW}(dnsmasq/unbound) for large third-party lists.${C_RESET}"
        issues=$((issues + 1))
    else
        echo "  ok"
    fi

    echo "-- OS-level resolution test (bypasses browser DNS-over-HTTPS):"
    local problems=0
    for key in "${PLATFORM_ORDER[@]}"; do
        sample="${PLATFORM_DOMAINS[$key]%% *}"
        ip="$(timeout 3 getent ahostsv4 "$sample" 2>/dev/null | awk 'NR==1 {print $1; exit}' || true)"
        if in_blocked "$key" && [ "$ip" != "$IP4" ]; then
            echo "  ${C_RED}$sample should be blocked but resolves to ${ip:-nothing}${C_RESET}"
            problems=$((problems + 1))
        elif ! in_blocked "$key" && [ "$ip" = "$IP4" ]; then
            echo "  ${C_YELLOW}$sample is allowed here but still resolves to $IP4 (another hosts entry)${C_RESET}"
            problems=$((problems + 1))
        fi
    done
    if [ "$problems" -eq 0 ]; then
        echo "  all ${#PLATFORM_ORDER[@]} platforms resolve as expected"
    else
        issues=$((issues + problems))
    fi
    echo
    echo "${C_YELLOW}Important:${C_RESET} if the checks above pass but a site still loads, the browser"
    echo "is using Secure DNS / DNS-over-HTTPS, which ignores $HOSTS entirely."
    echo "  - Firefox: Settings -> Privacy & Security -> DNS over HTTPS -> Off"
    echo "  - Chrome:  Settings -> Privacy and security -> Security -> Use secure DNS -> Off"
    echo
    if [ "$issues" -eq 0 ]; then
        echo "${C_GREEN}${C_BOLD}No problems found.${C_RESET}"
    else
        echo "${C_YELLOW}${C_BOLD}$issues problem(s) found.${C_RESET}"
        return 1
    fi
}

usage() {
    cat <<EOF
Usage: $PROG_NAME <command> [args]

  status [--json]              Show per-platform state             (no root)
  list                         List platform keys                  (no root)
  off                          Block ALL platforms                 (sudo)
  off <platform>...            Block only these platforms          (sudo)
  off --except a,b             Block everything except a and b     (sudo)
  on                           Allow ALL platforms                 (sudo)
  on <platform>...             Allow only these platforms          (sudo)
  block|unblock <platform>...  Same as off|on, platforms required  (sudo)
  sync                         Re-apply saved state to /etc/hosts  (sudo)
  doctor                       Diagnose problems                   (no root)
  version                      Print version

Aliases: x=twitter, fb=facebook, ig=instagram, 'all' = every platform.
'sudo' is invoked automatically when needed.

Examples:
  $PROG_NAME off
  $PROG_NAME off --except discord,twitch
  $PROG_NAME off instagram tiktok
  $PROG_NAME on instagram
  $PROG_NAME status
EOF
}

main() {
    local cmd="${1:-}"
    case "$cmd" in
        status)   shift; cmd_status "$@" ;;
        list)     cmd_list ;;
        on|off)   shift; cmd_toggle "$cmd" "$@" ;;
        block)    shift; [ "$#" -ge 1 ] || die "usage: $PROG_NAME block <platform>..."; cmd_toggle off "$@" ;;
        unblock)  shift; [ "$#" -ge 1 ] || die "usage: $PROG_NAME unblock <platform>..."; cmd_toggle on "$@" ;;
        sync)     cmd_sync ;;
        except)   shift; cmd_except "$@" ;;
        doctor)   cmd_doctor ;;
        -h|--help|help) usage ;;
        -V|--version|version) echo "$PROG_NAME $VERSION" ;;
        "")       usage >&2; exit 1 ;;
        *)
            # Forgiving order: "social-switch instagram off" -> "off instagram"
            if [ "$#" -eq 2 ] && [[ "$2" == on || "$2" == off ]] \
                && is_valid_platform "$(normalize_key "$1")"; then
                cmd_toggle "$2" "$1"
            else
                echo "Unknown command: $cmd" >&2
                usage >&2
                exit 1
            fi
            ;;
    esac
}

main "$@"
