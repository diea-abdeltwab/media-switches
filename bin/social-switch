#!/usr/bin/env bash
# social-switch
# Block/unblock social media sites system-wide via /etc/hosts.
# You can permanently exclude specific platforms (e.g. keep Discord open
# while blocking everything else).
#
# "on"  = social media is ON  (allowed / unblocked)
# "off" = social media is OFF (blocked)
#
# Install:
#   chmod +x social-switch
#   sudo mv social-switch /usr/local/bin/social-switch
#
# Usage:
#   social-switch status                    -> show what's blocked / allowed
#   social-switch list                      -> list available platform keys
#   sudo social-switch on                   -> allow everything (unblock)
#   sudo social-switch off                  -> block everything
#   sudo social-switch off --except a,b     -> block everything except a, b
#   sudo social-switch except add <name>    -> permanently allow a platform
#   sudo social-switch except remove <name> -> re-include a platform in blocks
#   social-switch except list               -> show currently excluded platforms
#   social-switch doctor                    -> diagnose why blocking may not be working
#
# "except" changes are saved and re-applied automatically the next time
# blocking is refreshed (including on the next "off"). If blocking is
# currently active, "except add/remove" also refreshes /etc/hosts right away.

set -euo pipefail

HOSTS="/etc/hosts"
BACKUP="/etc/hosts.bak"
IP="0.0.0.0"
CONFIG_DIR="/etc/social-switch"
EXCLUDE_FILE="$CONFIG_DIR/exclude"
STATE_FILE="$CONFIG_DIR/state"
BEGIN_MARK="# BEGIN social-switch managed block - do not edit below"
END_MARK="# END social-switch managed block"
PROG_NAME="$(basename "$0")"

if [ -t 1 ]; then
    C_RED=$'\033[1;31m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_BOLD=$'\033[1m'
    C_RESET=$'\033[0m'
else
    C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""; C_RESET=""
fi

# Platform key -> human label
declare -A PLATFORM_LABEL=(
    [facebook]="Facebook"
    [messenger]="Messenger"
    [instagram]="Instagram"
    [threads]="Threads"
    [twitter]="X / Twitter"
    [tiktok]="TikTok"
    [reddit]="Reddit"
    [snapchat]="Snapchat"
    [pinterest]="Pinterest"
    [tumblr]="Tumblr"
    [discord]="Discord"
    [twitch]="Twitch"
)

# Platform key -> domains (space-separated)
declare -A PLATFORM_DOMAINS=(
    [facebook]="facebook.com www.facebook.com m.facebook.com mbasic.facebook.com mobile.facebook.com fb.com www.fb.com"
    [messenger]="messenger.com www.messenger.com"
    [instagram]="instagram.com www.instagram.com"
    [threads]="threads.net www.threads.net"
    [twitter]="x.com www.x.com twitter.com www.twitter.com mobile.twitter.com tweetdeck.twitter.com"
    [tiktok]="tiktok.com www.tiktok.com m.tiktok.com vm.tiktok.com vt.tiktok.com"
    [reddit]="reddit.com www.reddit.com old.reddit.com new.reddit.com np.reddit.com amp.reddit.com"
    [snapchat]="snapchat.com www.snapchat.com web.snapchat.com"
    [pinterest]="pinterest.com www.pinterest.com pin.it"
    [tumblr]="tumblr.com www.tumblr.com"
    [discord]="discord.com www.discord.com discord.gg discordapp.com www.discordapp.com gateway.discord.gg cdn.discordapp.com media.discordapp.net"
    [twitch]="twitch.tv www.twitch.tv m.twitch.tv api.twitch.tv gql.twitch.tv player.twitch.tv clips.twitch.tv static.twitchcdn.net assets.twitch.tv"
)

# Fixed display order (bash associative arrays have no guaranteed order)
PLATFORM_ORDER=(facebook messenger instagram threads twitter tiktok reddit snapchat pinterest tumblr discord twitch)

require_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: this action needs root. Run: sudo $PROG_NAME ${1:-}"
        exit 1
    fi
}

is_valid_platform() {
    [ -n "${PLATFORM_LABEL[$1]+x}" ]
}

all_domains() {
    local key
    for key in "${PLATFORM_ORDER[@]}"; do
        echo "${PLATFORM_DOMAINS[$key]}"
    done
}

# --- exclude list handling -------------------------------------------------

load_excludes() {
    EXCLUDES=()
    if [ -f "$EXCLUDE_FILE" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] && EXCLUDES+=("$line")
        done < "$EXCLUDE_FILE"
    fi
}

save_excludes() {
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "${EXCLUDES[@]}" > "$EXCLUDE_FILE"
}

is_excluded() {
    local key="$1" e
    for e in "${EXCLUDES[@]:-}"; do
        [ "$e" = "$key" ] && return 0
    done
    return 1
}

save_state() {
    mkdir -p "$CONFIG_DIR"
    echo "$1" > "$STATE_FILE"
}

# Default state (no state file yet) is "on" = allowed, matching a fresh
# /etc/hosts that has never been touched by this script.
current_state() {
    [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "on"
}

# --- /etc/hosts editing ------------------------------------------------

lock_hosts() {
    chattr -i "$HOSTS" 2>/dev/null || true
}

unlock_hosts_and_relock_on_exit() {
    trap 'chattr +i "$HOSTS" 2>/dev/null || true' EXIT
}

flush_dns() {
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl flush-caches 2>/dev/null || true
    elif command -v systemd-resolve >/dev/null 2>&1; then
        systemd-resolve --flush-caches 2>/dev/null || true
    fi
}

# Remove the managed block (matched by EXACT line equality via awk, no
# regex/escaping involved — this is what previously could silently fail
# to match if the marker text contained characters sed treated specially,
# leaving a stale block behind and causing duplicate entries on the next
# "off").
remove_block() {
    if grep -qF "$BEGIN_MARK" "$HOSTS" 2>/dev/null; then
        awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
            $0==b {skip=1; next}
            $0==e {skip=0; next}
            skip {next}
            {print}
        ' "$HOSTS" > "$HOSTS.tmp.$$" && mv "$HOSTS.tmp.$$" "$HOSTS"
    fi
}

# Strip ANY stray line for a known domain, anywhere in the file, whether
# it was left by an older version of this script (which used to append
# domains without any markers at all) or added by hand. This is what
# actually fixes duplicate blocking entries — remove_block() alone only
# ever cleaned up its own marked block.
strip_stray_domain_lines() {
    local pattern_file="$CONFIG_DIR/.domains.$$"
    mkdir -p "$CONFIG_DIR"
    all_domains | tr ' ' '\n' | grep -v '^$' | sort -u > "$pattern_file"
    awk -v ip="$IP" 'BEGIN{
            while ((getline d < ARGV[1]) > 0) known[d]=1
            ARGV[1]=""
        }
        {
            split($0, f, /[ \t]+/)
            if (f[1]==ip && (f[2] in known)) next
            print
        }' "$pattern_file" "$HOSTS" > "$HOSTS.tmp.$$" && mv "$HOSTS.tmp.$$" "$HOSTS"
    rm -f "$pattern_file"
}

# Append a fresh managed block for every non-excluded platform
add_block() {
    local key domain
    {
        echo "$BEGIN_MARK"
        for key in "${PLATFORM_ORDER[@]}"; do
            is_excluded "$key" && continue
            for domain in ${PLATFORM_DOMAINS[$key]}; do
                echo "$IP $domain"
            done
        done
        echo "$END_MARK"
    } >> "$HOSTS"
}

# state: "on" (allowed, no block) or "off" (blocked)
refresh_state() {
    local want="$1"
    lock_hosts
    unlock_hosts_and_relock_on_exit
    [ -f "$BACKUP" ] || cp "$HOSTS" "$BACKUP"
    remove_block
    strip_stray_domain_lines
    if [ "$want" = "off" ]; then
        add_block
    fi
    flush_dns
}

# --- commands ------------------------------------------------------------

cmd_on() {
    require_root "on"
    echo "Unblocking social media..."
    refresh_state "on"
    save_state "on"
    echo
    echo "${C_GREEN}${C_BOLD}Done. Social media is now ON (allowed).${C_RESET}"
}

cmd_off() {
    require_root "off"
    load_excludes

    # Optional: sudo social-switch off --except a,b,c
    if [ "${1:-}" = "--except" ] && [ -n "${2:-}" ]; then
        IFS=',' read -ra requested <<< "$2"
        EXCLUDES=()
        local p
        for p in "${requested[@]}"; do
            p="$(echo "$p" | tr -d '[:space:]')"
            if is_valid_platform "$p"; then
                EXCLUDES+=("$p")
            else
                echo "${C_YELLOW}Warning: unknown platform '$p', ignoring.${C_RESET}"
            fi
        done
        save_excludes
    fi

    echo "Blocking social media..."
    refresh_state "off"
    save_state "off"

    echo
    echo "${C_RED}${C_BOLD}Done. Social media is now OFF (blocked).${C_RESET}"
    if [ "${#EXCLUDES[@]}" -gt 0 ]; then
        echo "Excluded (still allowed): ${EXCLUDES[*]}"
    fi
    echo "Backup of the original /etc/hosts: $BACKUP"
    echo
    echo "${C_YELLOW}Note:${C_RESET} browsers with Secure DNS / DNS-over-HTTPS enabled (common"
    echo "default in Firefox, and available in Chrome) can bypass /etc/hosts entirely."
    echo "Run '$PROG_NAME doctor' to check, or disable Secure DNS in the browser."
}

cmd_status() {
    load_excludes
    local blocked_count=0 total="${#PLATFORM_ORDER[@]}"

    echo "===== Social Media Block Status ====="
    if grep -qF "$BEGIN_MARK" "$HOSTS" 2>/dev/null; then
        echo "Managed block present in $HOSTS: ${C_YELLOW}yes${C_RESET}"
    else
        echo "Managed block present in $HOSTS: ${C_YELLOW}no${C_RESET}"
    fi
    echo "Saved preference: ${C_BOLD}$(current_state)${C_RESET}"
    echo

    printf "%-14s %-14s %s\n" "PLATFORM" "STATUS" "SAMPLE DOMAIN"
    local key sample
    for key in "${PLATFORM_ORDER[@]}"; do
        sample="$(echo "${PLATFORM_DOMAINS[$key]}" | awk '{print $1}')"
        if is_excluded "$key"; then
            printf "%-14s ${C_GREEN}%-14s${C_RESET} %s\n" "${PLATFORM_LABEL[$key]}" "allowed*" "$sample"
        elif grep -Eq "^[[:space:]]*${IP//./\\.}[[:space:]]+${sample}([[:space:]]|$)" "$HOSTS" 2>/dev/null; then
            printf "%-14s ${C_RED}%-14s${C_RESET} %s\n" "${PLATFORM_LABEL[$key]}" "blocked" "$sample"
            ((++blocked_count))
        else
            printf "%-14s ${C_YELLOW}%-14s${C_RESET} %s\n" "${PLATFORM_LABEL[$key]}" "allowed" "$sample"
        fi
    done
    echo
    echo "$blocked_count / $total platforms currently blocked."
    echo "* = permanently excluded via 'except'"
}

cmd_list() {
    echo "Available platform keys:"
    local key
    for key in "${PLATFORM_ORDER[@]}"; do
        printf "  %-12s %s\n" "$key" "${PLATFORM_LABEL[$key]}"
    done
}

cmd_except() {
    local action="${1:-}"; shift || true
    load_excludes

    case "$action" in
        add)
            require_root "except add <name>"
            [ "$#" -ge 1 ] || { echo "Usage: sudo $PROG_NAME except add <platform> [platform...]"; exit 1; }
            local p changed=0
            for p in "$@"; do
                if ! is_valid_platform "$p"; then
                    echo "${C_YELLOW}Unknown platform '$p', skipping. See '$PROG_NAME list'.${C_RESET}"
                    continue
                fi
                if is_excluded "$p"; then
                    echo "'$p' is already excluded."
                else
                    EXCLUDES+=("$p")
                    echo "Excluding '$p'."
                    changed=1
                fi
            done
            save_excludes
            if [ "$changed" -eq 1 ] && [ "$(current_state)" = "off" ]; then
                echo "Refreshing active block..."
                refresh_state "off"
            fi
            ;;
        remove)
            require_root "except remove <name>"
            [ "$#" -ge 1 ] || { echo "Usage: sudo $PROG_NAME except remove <platform> [platform...]"; exit 1; }
            local p changed=0 new=()
            for p in "${EXCLUDES[@]:-}"; do
                local drop=0 arg
                for arg in "$@"; do
                    [ "$p" = "$arg" ] && { drop=1; changed=1; echo "Re-including '$p'."; }
                done
                [ "$drop" -eq 0 ] && new+=("$p")
            done
            EXCLUDES=("${new[@]:-}")
            save_excludes
            if [ "$changed" -eq 1 ] && [ "$(current_state)" = "off" ]; then
                echo "Refreshing active block..."
                refresh_state "off"
            fi
            ;;
        list|"")
            if [ "${#EXCLUDES[@]}" -eq 0 ]; then
                echo "No platforms are currently excluded."
            else
                echo "Excluded platforms (always allowed):"
                local p
                for p in "${EXCLUDES[@]}"; do
                    printf "  %-12s %s\n" "$p" "${PLATFORM_LABEL[$p]:-?}"
                done
            fi
            ;;
        *)
            echo "Usage: $PROG_NAME except {add|remove|list} [platform...]"
            exit 1
            ;;
    esac
}

cmd_doctor() {
    cmd_status
    echo
    echo "===== Sanity checks ====="

    echo "-- Duplicate entries in $HOSTS for blocked domains:"
    local dupes
    dupes="$(awk -v ip="$IP" '$1==ip {print $2}' "$HOSTS" 2>/dev/null | sort | uniq -c | awk '$1>1')"
    if [ -n "$dupes" ]; then
        echo "${C_YELLOW}$dupes${C_RESET}"
        echo "  Found duplicates — run 'sudo $PROG_NAME off' again to clean them up automatically."
    else
        echo "  none found"
    fi
    echo

    echo "-- OS-level resolution test (bypasses browser DNS-over-HTTPS):"
    local key sample
    for key in facebook instagram twitter tiktok; do
        sample="$(echo "${PLATFORM_DOMAINS[$key]}" | awk '{print $1}')"
        local result
        result="$(getent hosts "$sample" 2>/dev/null | awk '{print $1}' || echo "no-resolve")"
        if [ "$result" = "$IP" ]; then
            echo "  ${C_RED}$sample -> $IP (blocked at OS level)${C_RESET}"
        else
            echo "  ${C_GREEN}$sample -> ${result:-unresolved} (NOT blocked at OS level)${C_RESET}"
        fi
    done
    echo

    echo "-- Is /etc/hosts locked (immutable)?"
    if command -v lsattr >/dev/null 2>&1; then
        lsattr "$HOSTS" 2>/dev/null || echo "  (couldn't check — needs root or unsupported filesystem)"
    else
        echo "  lsattr not available"
    fi
    echo

    echo "${C_YELLOW}Important:${C_RESET} if the OS-level test above shows domains ARE blocked"
    echo "(resolve to $IP) but the sites still load in your browser, the browser is"
    echo "very likely using Secure DNS / DNS-over-HTTPS (DoH), which bypasses"
    echo "/etc/hosts completely and queries an encrypted DNS server directly."
    echo "  - Firefox: Settings -> Privacy & Security -> DNS over HTTPS -> Off"
    echo "  - Chrome:  Settings -> Privacy and security -> Security -> Use secure DNS -> Off"
    echo "This is a browser setting, not something this script can control."
}

usage() {
    echo "Usage: $PROG_NAME {status|list|on|off|except|doctor} ..."
    echo
    echo "  status                      Show block status per platform (no root)"
    echo "  list                        List available platform keys (no root)"
    echo "  on                          Allow social media / remove block (needs sudo)"
    echo "  off [--except a,b,c]        Block social media, optionally excluding platforms (needs sudo)"
    echo "  except add <name>...        Permanently allow a platform, even when 'off' (needs sudo)"
    echo "  except remove <name>...     Re-include a platform in blocks (needs sudo)"
    echo "  except list                 Show currently excluded platforms (no root)"
    echo "  doctor                      Diagnose duplicates / DoH bypass issues (no root)"
    echo
    echo "Examples:"
    echo "  sudo $PROG_NAME off --except discord,twitch"
    echo "  sudo $PROG_NAME except add reddit"
    echo "  $PROG_NAME status"
    echo "  $PROG_NAME doctor"
}

case "${1:-}" in
    status)
        cmd_status
        ;;
    list)
        cmd_list
        ;;
    on)
        cmd_on
        ;;
    off)
        shift
        cmd_off "$@"
        ;;
    except)
        shift
        cmd_except "$@"
        ;;
    doctor)
        cmd_doctor
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
